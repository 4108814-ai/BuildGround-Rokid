<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: the same bust and glint as the HUD mark, but drawn for a
  screen rather than for additive optics.
  Here the glint is solid, which is what the glyph cannot afford - a filled
  shape on the glasses emits as a green lozenge, while on a phone it is simply
  the strongest way to say which part carries the meaning. The bust stays
  stroked, so the eye lands on the spark first and reads the person second.
  This is the mark the Store shows, so it is the mark the app drawer shows too.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <!-- The head. -->
    <path android:pathData="M6.3,8.6 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- The shoulders. -->
    <path android:pathData="M3.0,20.6 A6.6,6.6 0 0 1 16.2,20.6"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- The glint, solid: on a screen this is the part that must carry. -->
    <path android:pathData="M18.8,1.0 Q19.25,5.15 23.4,5.6 Q19.25,6.05 18.8,10.2 Q18.35,6.05 14.2,5.6 Q18.35,5.15 18.8,1.0 Z"
        android:fillColor="#FF4DFF8C" />
</vector>
