<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: the same two bubbles as the HUD glyph, but drawn for a
  screen rather than for additive optics.
  Here the reply bubble is solid, which is what the glyph cannot afford - a
  filled shape on the glasses emits as a green lozenge, while on a phone it is
  simply the strongest way to say "this one is yours". The gutter between the
  two is painted in the icon's own background colour, so the bubbles read as
  overlapping rather than welded together.
  This is the mark the Store shows, so it is the mark the app drawer shows too:
  whatever the wearer tapped to install is what they find afterwards.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <!-- The message that arrived. -->
    <path android:pathData="M4.6,2.9 L13.4,2.9 A2.1,2.1 0 0 1 15.5,5 L15.5,9.4 A2.1,2.1 0 0 1 13.4,11.5 L8.4,11.5 L5.5,14.6 L5.5,11.5 A2.1,2.1 0 0 1 3.4,9.4 L3.4,5 A2.1,2.1 0 0 1 5.5,2.9 Z"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- The gutter: background colour, so the two bubbles overlap instead of merging. -->
    <path android:pathData="M10.5,9.8 L19.7,9.8 A3.2,3.2 0 0 1 21.8,12.9 L21.8,16.6 A3.2,3.2 0 0 1 19.7,19.7 L19.0,19.7 L19.0,22.9 L14.3,19.7 L10.5,19.7 A3.2,3.2 0 0 1 8.4,16.6 L8.4,12.9 A3.2,3.2 0 0 1 10.5,9.8 Z"
        android:fillColor="#FF030C06" />
    <!-- The answer going back. -->
    <path android:pathData="M11.6,10.9 L18.6,10.9 A2.1,2.1 0 0 1 20.7,13 L20.7,16.5 A2.1,2.1 0 0 1 18.6,18.6 L17.9,18.6 L17.9,21.4 L15.2,18.6 L11.6,18.6 A2.1,2.1 0 0 1 9.5,16.5 L9.5,13 A2.1,2.1 0 0 1 11.6,10.9 Z"
        android:fillColor="#FF4DFF8C" />
</vector>
