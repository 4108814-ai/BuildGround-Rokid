<?xml version="1.0" encoding="utf-8"?>
<!--
  The plugin's own mark: a message bubble with two lines of someone else's
  words in it. Stroked, not filled - on additive optics a filled bubble emits
  as a solid green lozenge and loses the one detail that says "a message"
  rather than "a shape".
  The tail is square and sits at the bottom left, where a received message's
  tail sits in every chat app the wearer already uses. A centred or right-hand
  tail would read as their own outgoing reply, which is the opposite of what
  this plugin announces.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp" android:viewportWidth="24" android:viewportHeight="24">
    <path android:pathData="M6,4.5 L18,4.5 A2.5,2.5 0 0 1 20.5,7 L20.5,13.5 A2.5,2.5 0 0 1 18,16 L9.5,16 L5.5,20 L5.5,16 A2.5,2.5 0 0 1 3.5,13.5 L3.5,7 A2.5,2.5 0 0 1 6,4.5 Z"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M7.5,8.8 L15.5,8.8"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7" android:strokeLineCap="round" android:strokeLineJoin="round" />
    <path android:pathData="M7.5,12.2 L13,12.2"
        android:strokeColor="#FF4DFF8C" android:strokeWidth="1.7" android:strokeLineCap="round" android:strokeLineJoin="round" />
</vector>
