<resources>
    <string name="accessibility_service_description">Pilote les commandes Nexus et guide l’appairage Wireless Debugging sécurisé pendant la configuration initiale.</string>
    <string name="accessibility_service_summary">Commandes Nexus et configuration initiale sécurisée</string>

    <!-- Configuration initiale, affichée dans l’optique. Lignes courtes : ~29 colonnes. -->
    <string name="onb_footer">Tap : continuer · Retour : quitter</string>
    <string name="onb_support_code">Code support : %1$s</string>

    <string name="onb_accessibility_eyebrow">CONFIGURATION</string>
    <string name="onb_accessibility_title">Activez Rokid Nexus Glasses</string>
    <string name="onb_accessibility_body">Trouvez « Rokid Nexus Glasses » dans la liste des Réglages et activez-le.\n\nNexus revient aussitôt ici et termine tout seul.</string>
    <string name="onb_accessibility_action">OUVRIR LES RÉGLAGES</string>

    <string name="onb_running_eyebrow">CONFIGURATION EN COURS</string>
    <string name="onb_running_title">Nexus termine</string>
    <string name="onb_running_body">%1$s\n\nGardez les lunettes sur vous. Comptez 1 à 2 minutes.</string>
    <string name="onb_running_status">En cours…</string>
    <string name="onb_running_recovery_action">TERMINER</string>

    <string name="onb_wifi_eyebrow">EN PAUSE</string>
    <string name="onb_wifi_title">Wi-Fi nécessaire</string>
    <string name="onb_wifi_body">Connectez les lunettes au Wi-Fi depuis l’app Hi Rokid sur votre téléphone.\n\nNexus reprend là où il s’est arrêté dès qu’elles sont en ligne.</string>
    <string name="onb_wifi_action">RÉESSAYER</string>

    <string name="onb_manual_eyebrow">À FINIR SUR LE TÉLÉPHONE</string>
    <string name="onb_manual_title">Nexus a besoin d’un coup de main</string>
    <string name="onb_manual_body">La configuration automatique n’a pas pu aboutir ici. Ouvrez Rokid Nexus sur votre téléphone et suivez la configuration guidée.</string>
    <string name="onb_manual_action">RÉESSAYER ICI</string>

    <string name="onb_failed_eyebrow">CONFIGURATION INTERROMPUE</string>
    <string name="onb_failed_title">On réessaie</string>
    <string name="onb_failed_body">%1$s\n\nTapez pour réessayer — Nexus relance la configuration sécurisée.</string>
    <string name="onb_failed_action">RÉESSAYER</string>

    <string name="onb_unsupported_eyebrow">INDISPONIBLE</string>
    <string name="onb_unsupported_title">Android 11 requis</string>
    <string name="onb_unsupported_body">Ce firmware n’expose pas l’API d’appairage Wireless Debugging. Utilisez la solution ADB pm grant documentée.</string>
    <string name="onb_unsupported_action">PAS DE CONFIG SANS FIL</string>

    <string name="onb_done_eyebrow">CONFIGURATION TERMINÉE</string>
    <string name="onb_done_title">Tout est prêt</string>
    <string name="onb_done_body">Rokid Nexus est armé et opérationnel.</string>

    <!-- Lignes d’étape. Une phrase courte : elle s’insère dans onb_running_body. -->
    <string name="onb_phase_unknown">Préparation…</string>
    <string name="onb_phase_waiting_for_accessibility">En attente de l’activation de Rokid Nexus Glasses.</string>
    <string name="onb_phase_waiting_for_wifi">En attente d’un réseau Wi-Fi.</string>
    <string name="onb_phase_enabling_developer_options">Déverrouillage des options développeur…</string>
    <string name="onb_phase_opening_wireless_debugging">Ouverture du débogage sans fil…</string>
    <string name="onb_phase_reading_pairing_dialog">Lecture des infos d’appairage…</string>
    <string name="onb_phase_pairing_locally">Appairage sécurisé…</string>
    <string name="onb_phase_pairing_via_phone">Votre téléphone termine l’appairage…</string>
    <string name="onb_phase_arming">Armement de Nexus…</string>
    <string name="onb_phase_complete">Configuration sécurisée terminée.</string>
    <string name="onb_phase_manual_required">La configuration automatique n’a pas abouti.</string>
    <string name="onb_phase_failed">La configuration s’est arrêtée avant la fin.</string>

    <!-- Motifs d’échec, affichés à la place de la ligne d’étape. -->
    <string name="onb_reason_lease_expired">La configuration s’est bloquée et a été arrêtée.</string>
    <string name="onb_reason_wifi_required">Pas de réseau Wi-Fi. Connectez les lunettes, puis réessayez.</string>
    <string name="onb_reason_pairing_expired">L’étape d’appairage a expiré.</string>
    <string name="onb_reason_wireless_timeout">Le débogage sans fil a expiré.</string>
    <string name="onb_reason_wireless_manual_step">Le débogage sans fil demande un tap manuel.</string>
    <string name="onb_reason_developer_manual_step">Les options développeur demandent un tap manuel.</string>
    <string name="onb_reason_accessibility_unavailable">Impossible d’ouvrir les réglages d’accessibilité.</string>
    <string name="onb_reason_phone_pairing_timeout">Le téléphone n’a pas terminé l’appairage à temps.</string>
    <string name="onb_reason_phone_verification_failed">Le téléphone a appairé, mais la vérification n’a pas abouti.</string>
    <string name="onb_reason_generic">La configuration n’a pas pu aboutir.</string>
</resources>
