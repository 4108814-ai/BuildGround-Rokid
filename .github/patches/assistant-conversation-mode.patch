+++ b/plugins/assistant/src/main/java/com/anezium/rokidbus/plugin/assistant/AssistantFollowUpController.kt
@@ -0,0 +1,86 @@
+package com.anezium.rokidbus.plugin.assistant
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+
+internal class AssistantFollowUpController(
+    private val scope: CoroutineScope,
+    private val startFollowUp: () -> Unit,
+    private val silenceExpired: () -> Unit,
+    private val followUpDelayMs: Long = FOLLOW_UP_DELAY_MS,
+    private val silenceTimeoutMs: Long = FOLLOW_UP_SILENCE_TIMEOUT_MS,
+) {
+    private var session = 0L
+    private var active = false
+    private var awaitingTts = false
+    private var followUpJob: Job? = null
+    private var silenceJob: Job? = null
+
+    fun start(enabled: Boolean) {
+        cancelJobs()
+        session += 1
+        active = enabled
+        awaitingTts = false
+    }
+
+    fun answerCompleted(waitForTts: Boolean) {
+        if (!active) return
+        awaitingTts = waitForTts
+        if (!waitForTts) scheduleFollowUp()
+    }
+
+    fun ttsDone() {
+        if (!active || !awaitingTts) return
+        awaitingTts = false
+        scheduleFollowUp()
+    }
+
+    fun ttsUnavailable() {
+        ttsDone()
+    }
+
+    fun markUserSpeechStarted() {
+        silenceJob?.cancel()
+        silenceJob = null
+    }
+
+    fun cancel() {
+        cancelJobs()
+        session += 1
+        active = false
+        awaitingTts = false
+    }
+
+    private fun scheduleFollowUp() {
+        followUpJob?.cancel()
+        val scheduledSession = session
+        followUpJob = scope.launch {
+            delay(followUpDelayMs)
+            followUpJob = null
+            if (!active || session != scheduledSession) return@launch
+            startFollowUp()
+            if (!active || session != scheduledSession) return@launch
+            silenceJob = scope.launch {
+                delay(silenceTimeoutMs)
+                silenceJob = null
+                if (!active || session != scheduledSession) return@launch
+                active = false
+                silenceExpired()
+            }
+        }
+    }
+
+    private fun cancelJobs() {
+        followUpJob?.cancel()
+        followUpJob = null
+        silenceJob?.cancel()
+        silenceJob = null
+    }
+
+    companion object {
+        const val FOLLOW_UP_DELAY_MS = 3_000L
+        const val FOLLOW_UP_SILENCE_TIMEOUT_MS = 10_000L
+    }
+}
