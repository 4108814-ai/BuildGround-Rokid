diff --git a/plugins/assistant/src/test/java/com/anezium/rokidbus/plugin/assistant/AssistantFollowUpControllerTest.kt b/plugins/assistant/src/test/java/com/anezium/rokidbus/plugin/assistant/AssistantFollowUpControllerTest.kt
new file mode 100644
index 00000000..3585cdd8
--- /dev/null
+++ b/plugins/assistant/src/test/java/com/anezium/rokidbus/plugin/assistant/AssistantFollowUpControllerTest.kt
@@ -0,0 +1,145 @@
+package com.anezium.rokidbus.plugin.assistant
+
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AssistantFollowUpControllerTest {
+    @Test
+    fun silentAnswerStartsExactlyAtThreeSeconds() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(waitForTts = false)
+
+        advanceTimeBy(2_999L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+        advanceTimeBy(1L)
+        runCurrent()
+        assertEquals(listOf("capture"), events)
+    }
+
+    @Test
+    fun spokenAnswerWaitsForTtsThenThreeSeconds() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(waitForTts = true)
+        advanceTimeBy(20_000L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+
+        controller.ttsDone()
+        advanceTimeBy(2_999L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+        advanceTimeBy(1L)
+        runCurrent()
+        assertEquals(listOf("capture"), events)
+    }
+
+    @Test
+    fun cancelDuringDelayPreventsFollowUp() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(false)
+        controller.cancel()
+        advanceTimeBy(3_000L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+    }
+
+    @Test
+    fun manualStartReplacesScheduledFollowUp() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(false)
+        controller.start(true)
+        events += "manual"
+        advanceTimeBy(3_000L)
+        runCurrent()
+        assertEquals(listOf("manual"), events)
+    }
+
+    @Test
+    fun providerFailureCancellationDoesNotFollowUp() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.cancel()
+        advanceTimeBy(30_000L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+    }
+
+    @Test
+    fun staleSessionCannotStart() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(false)
+        controller.start(false)
+        advanceTimeBy(3_000L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+    }
+
+    @Test
+    fun silenceTimeoutEndsSessionOnce() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(false)
+        advanceTimeBy(3_000L)
+        runCurrent()
+        advanceTimeBy(9_999L)
+        runCurrent()
+        assertEquals(listOf("capture"), events)
+        advanceTimeBy(1L)
+        runCurrent()
+        assertEquals(listOf("capture", "silence"), events)
+        advanceTimeBy(20_000L)
+        runCurrent()
+        assertEquals(listOf("capture", "silence"), events)
+    }
+
+    @Test
+    fun userSpeechCancelsSilenceTimeout() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(true)
+        controller.answerCompleted(false)
+        advanceTimeBy(3_000L)
+        runCurrent()
+        advanceTimeBy(9_000L)
+        controller.markUserSpeechStarted()
+        advanceTimeBy(2_000L)
+        runCurrent()
+        assertEquals(listOf("capture"), events)
+    }
+
+    @Test
+    fun modeOffLeavesSingleTurnBehaviour() = runTest {
+        val events = mutableListOf<String>()
+        val controller = controller(events)
+        controller.start(false)
+        controller.answerCompleted(false)
+        advanceTimeBy(30_000L)
+        runCurrent()
+        assertEquals(emptyList<String>(), events)
+    }
+
+    private fun kotlinx.coroutines.test.TestScope.controller(events: MutableList<String>) =
+        AssistantFollowUpController(
+            scope = this,
+            startFollowUp = { events += "capture" },
+            silenceExpired = { events += "silence" },
+        )
+}
