+package com.anezium.rokidbus.phone
+
+import org.junit.Assert.*
+import org.junit.Test
+
+/** Recording callbacks only; never constructs CXRLink or calls an Android installer. */
+class LocalGlassesTransferBoundaryTest {
+    @Test fun verifiesThenRecordsThenRechecksBeforeOneHandoff() {
+        val events = mutableListOf<String>()
+        LocalGlassesTransferBoundary.handoff({ events += "check" }, { events += "record" }, { events += "transfer" })
+        assertEquals(listOf("check", "record", "check", "transfer"), events)
+    }
+
+    @Test fun disconnectedBeforeReservationDoesNotRecordOrTransfer() {
+        var writes = 0; var transfers = 0
+        rejected { LocalGlassesTransferBoundary.handoff({ error("disconnected") }, { writes++ }, { transfers++ }) }
+        assertEquals(0, writes); assertEquals(0, transfers)
+    }
+
+    @Test fun disconnectWhileRecordingRetainsAttemptAndNeverHandsOff() {
+        var connected = true; var recorded = false; var transfers = 0
+        rejected {
+            LocalGlassesTransferBoundary.handoff({ check(connected) },
+                { recorded = true; connected = false }, { transfers++ })
+        }
+        assertTrue(recorded); assertEquals(0, transfers)
+    }
+
+    @Test fun recordingFailureStopsExternalCall() {
+        var transfers = 0
+        rejected { LocalGlassesTransferBoundary.handoff({}, { error("disk failure") }, { transfers++ }) }
+        assertEquals(0, transfers)
+    }
+
+    @Test fun externalFailureHasOneAttemptAndNoRetryOrRecordRemoval() {
+        var records = 0; var transfers = 0
+        rejected { LocalGlassesTransferBoundary.handoff({}, { records++ }, { transfers++; error("unknown outcome") }) }
+        assertEquals(1, records); assertEquals(1, transfers)
+    }
+
+    @Test fun expiryWhileRecordingStopsHandoff() {
+        val owner = Any()
+        val candidate = LocalGlassesApkSelection(LocalGlassesApkRole.CANDIDATE, LocalGlassesApkPolicy.CANDIDATE_SHA)
+        val recovery = LocalGlassesApkSelection(LocalGlassesApkRole.RECOVERY, "a".repeat(64))
+        val approval = LocalGlassesInstallApproval(candidate, recovery, owner, 1, 0)
+        var now = 1L; var transfers = 0
+        assertTrue(approval.consume(owner, 1, now))
+        rejected {
+            LocalGlassesTransferBoundary.handoff({ check(approval.isContextCurrent(owner, 1, now)) },
+                { now = 120001 }, { transfers++ })
+        }
+        assertEquals(0, transfers)
+    }
+
+    private fun rejected(work: () -> Unit) {
+        try { work(); fail("Expected rejection") } catch (_: IllegalStateException) { }
+    }
+}
