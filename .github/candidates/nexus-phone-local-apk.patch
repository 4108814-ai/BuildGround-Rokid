+package com.anezium.rokidbus.phone
+
+import android.app.Activity
+import android.app.AlertDialog
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import java.util.concurrent.Executors
+
+/** Non-exported, user-operated diagnostic entry point. Never enables or starts the hub. */
+class LocalGlassesApkActivity : Activity() {
+    private lateinit var status: TextView
+    private lateinit var recoveryHash: EditText
+    private val store by lazy { LocalGlassesApkStore(applicationContext) }
+    private val worker = Executors.newSingleThreadExecutor()
+    private var pending: LocalGlassesApkSelection? = null
+    private var selected: LocalGlassesApkSelection? = null
+    private var dialog: AlertDialog? = null
+    private var busy = false
+    private var resumed = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val column = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL; setPadding(24, 24, 24, 24) }
+        status = TextView(this).apply {
+            text = "SPP candidate: glasses 1.4.30 / 10430 only. Save a previous signed release before transfer. " +
+                "This is a user-selected recovery file, NOT a copy of the installed glasses APK. " +
+                "Compatibility and recovery still require a device check. No app is opened after transfer."
+        }
+        column.addView(status)
+        recoveryHash = EditText(this).apply {
+            hint = "Previous release SHA-256 from the trusted release record"
+            setSingleLine(true)
+        }
+        column.addView(recoveryHash)
+        fun button(label: String, action: () -> Unit) {
+            column.addView(Button(this).apply { text = label; setOnClickListener { if (!busy) action() } })
+        }
+        button("Choose previous signed APK") {
+            val hash = recoveryHash.text.toString().trim().lowercase()
+            if (!hash.matches(Regex("[0-9a-f]{64}"))) status.text = "Enter the trusted release SHA-256 first."
+            else choose(LocalGlassesApkSelection(LocalGlassesApkRole.RECOVERY, hash))
+        }
+        button("Choose SPP candidate APK") {
+            choose(LocalGlassesApkSelection(LocalGlassesApkRole.CANDIDATE, LocalGlassesApkPolicy.CANDIDATE_SHA))
+        }
+        button("Review selected APK transfer") {
+            selected?.let(::review) ?: run { status.text = "Choose and verify an APK first." }
+        }
+        button("Review saved recovery APK") {
+            background({ store.recovery() }) { review(it) }
+        }
+        button("Acknowledge previous transfer after checking glasses") {
+            dialog = AlertDialog.Builder(this).setMessage(
+                "Only clear this local record after inspecting the glasses. This does not undo or retry an install."
+            ).setNegativeButton("Cancel", null).setPositiveButton("I checked the glasses") { _, _ ->
+                runCatching { BusHubService.acknowledgeLocalGlassesAttempt(applicationContext) }
+                    .onSuccess { status.text = "Local attempt record acknowledged. No transfer started." }
+                    .onFailure { status.text = it.message }
+            }.show()
+        }
+        setContentView(ScrollView(this).apply { addView(column) })
+    }
+
+    private fun choose(selection: LocalGlassesApkSelection) {
+        if (pending != null) return
+        selected = null
+        pending = selection
+        runCatching {
+            startActivityForResult(Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+                addCategory(Intent.CATEGORY_OPENABLE)
+                type = "application/vnd.android.package-archive"
+                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            }, 10430)
+        }.onFailure { pending = null; status.text = "No document picker is available." }
+    }
+
+    @Deprecated("Platform activity result API")
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        if (requestCode != 10430) return
+        val selection = pending.also { pending = null } ?: return
+        val uri = data?.data
+        if (resultCode != RESULT_OK || uri == null) return
+        background({ store.importSelected(uri, selection); selection }) {
+            selected = it
+            status.text = "Verified ${it.role}: 1.4.30 / 10430\nSHA-256: ${it.sha256}\nNothing transferred."
+        }
+    }
+
+    private fun review(selection: LocalGlassesApkSelection) {
+        background({
+            check(!store.hasAttempt()) { "Inspect the glasses and acknowledge the previous transfer first." }
+            store.verify(selection)
+            store.recovery()
+        }) { recovery ->
+            if (!resumed) return@background
+            val approval = runCatching { BusHubService.reviewLocalGlassesApk(selection, recovery) }
+                .getOrElse { status.text = it.message; return@background }
+            dialog = AlertDialog.Builder(this).setTitle("Transfer ${selection.role} to glasses?")
+                .setMessage("Package: ${LocalGlassesApkPolicy.PACKAGE}\nVersion: 1.4.30 / 10430\n" +
+                    "SHA-256: ${selection.sha256}\n\nSaved recovery SHA-256: ${recovery.sha256}\n" +
+                    "Recovery is a selected historical APK, not an installed-app backup. " +
+                    "Android may reject replacement; its protections remain in force. " +
+                    "An accepted CXR command does not prove the installed version or fix SPP.")
+                .setNegativeButton("Cancel", null)
+                .setPositiveButton("Transfer this APK") { _, _ ->
+                    busy = true
+                    status.text = "Verifying again before CXR transfer..."
+                    BusHubService.transferLocalGlassesApk(approval) { message ->
+                        runOnUiThread { if (!isDestroyed) { busy = false; status.text = message } }
+                    }
+                }.show()
+        }
+    }
+
+    private fun <T> background(work: () -> T, success: (T) -> Unit) {
+        busy = true
+        worker.execute {
+            val result = runCatching(work)
+            runOnUiThread {
+                if (!isDestroyed && !isFinishing) {
+                    busy = false
+                    result.onSuccess(success).onFailure { status.text = it.message ?: "Verification failed." }
+                }
+            }
+        }
+    }
+
+    override fun onResume() { super.onResume(); resumed = true }
+    override fun onPause() { resumed = false; super.onPause() }
+    override fun onStop() { dialog?.dismiss(); dialog = null; super.onStop() }
+    override fun onDestroy() { worker.shutdown(); super.onDestroy() }
+}
