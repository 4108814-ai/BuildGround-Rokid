+package com.anezium.rokidbus.phone
+
+import java.io.InputStream
+import java.io.OutputStream
+import java.util.concurrent.atomic.AtomicBoolean
+
+internal enum class LocalGlassesApkRole { CANDIDATE, RECOVERY }
+
+internal data class LocalGlassesApkMetadata(
+    val packageName: String,
+    val versionCode: Long,
+    val versionName: String?,
+    val signerDigests: List<String>,
+)
+
+internal data class LocalGlassesApkSelection(val role: LocalGlassesApkRole, val sha256: String)
+
+/** Deliberately limited to the reviewed SPP experiment, not a general installer. */
+internal object LocalGlassesApkPolicy {
+    const val PACKAGE = "com.anezium.rokidbus.glasses"
+    const val VERSION_CODE = 10430L
+    const val VERSION_NAME = "1.4.30"
+    const val SIGNER = "55b22185392b8c1f084c3dec58bb0f342ece7102289556ae23cadee6ccec2097"
+    const val CANDIDATE_SHA = "bffde442763cb71471a41b5d050f8b4a6832612567e3b80748d094f55002de03"
+    const val MAX_BYTES = 64L * 1024 * 1024
+
+    fun validate(metadata: LocalGlassesApkMetadata?, digest: String, selection: LocalGlassesApkSelection) {
+        require(selection.sha256.matches(Regex("[0-9a-f]{64}"))) { "A trusted SHA-256 is required." }
+        require(digest == selection.sha256) { "APK SHA-256 does not match the expected file." }
+        require(metadata != null) { "Android could not verify the APK metadata/signature." }
+        require(metadata.packageName == PACKAGE) { "Only the Nexus glasses package is allowed." }
+        require(metadata.versionCode == VERSION_CODE && metadata.versionName == VERSION_NAME) {
+            "Only version 1.4.30 / 10430 is allowed; no version downgrade is requested."
+        }
+        require(metadata.signerDigests == listOf(SIGNER)) { "The APK must have the single BuildGround release signer." }
+        when (selection.role) {
+            LocalGlassesApkRole.CANDIDATE -> require(digest == CANDIDATE_SHA) { "This is not the reviewed candidate." }
+            LocalGlassesApkRole.RECOVERY -> require(digest != CANDIDATE_SHA) { "Select the previous release, not the candidate." }
+        }
+    }
+
+    fun copyBounded(input: InputStream, output: OutputStream, limit: Long = MAX_BYTES) {
+        var size = 0L
+        val buffer = ByteArray(8192)
+        while (true) {
+            val count = input.read(buffer)
+            if (count < 0) break
+            size += count
+            require(size <= limit) { "APK exceeds the size limit." }
+            output.write(buffer, 0, count)
+        }
+        require(size > 0L) { "The selected file is empty." }
+    }
+}
+
+/** In-memory only. Rotation, process death and service replacement cannot replay a transfer. */
+internal class LocalGlassesInstallApproval(
+    val selection: LocalGlassesApkSelection,
+    val recovery: LocalGlassesApkSelection,
+    private val owner: Any,
+    private val generation: Long,
+    private val issuedAt: Long,
+) {
+    private val consumed = AtomicBoolean(false)
+    fun isContextCurrent(currentOwner: Any, currentGeneration: Long, now: Long): Boolean =
+        currentOwner === owner && currentGeneration == generation &&
+            now >= issuedAt && now - issuedAt <= 120_000L
+
+    fun consume(currentOwner: Any, currentGeneration: Long, now: Long): Boolean =
+        isContextCurrent(currentOwner, currentGeneration, now) && consumed.compareAndSet(false, true)
+}
+
+/** The final check follows persistence too: writing the record may outlive the connection. */
+internal object LocalGlassesTransferBoundary {
+    fun handoff(checkContext: () -> Unit, reserveAttempt: () -> Unit, transfer: () -> Unit) {
+        checkContext()
+        reserveAttempt()
+        checkContext()
+        transfer()
+    }
