+package com.anezium.rokidbus.phone
+
+import android.content.Context
+import android.net.Uri
+import android.util.AtomicFile
+import java.io.File
+import java.io.FileOutputStream
+import java.security.MessageDigest
+
+/** Private, content-addressed copies. No persisted URI grant, provider path or display name. */
+internal class LocalGlassesApkStore(private val context: Context) {
+    private val root = File(context.noBackupFilesDir, "local-glasses-apks").apply {
+        check(isDirectory || mkdirs()) { "Could not create private APK storage." }
+    }
+    private val recoveryRecord = AtomicFile(File(root, "selected-recovery"))
+    private val attemptRecord = AtomicFile(File(root, "transfer-attempt"))
+
+    fun importSelected(uri: Uri, selection: LocalGlassesApkSelection): File = synchronized(lock) {
+        require(uri.scheme == "content") { "Select a file using the Android document picker." }
+        val temporary = File.createTempFile("selected-", ".apk", root)
+        try {
+            context.contentResolver.openInputStream(uri).use { input ->
+                requireNotNull(input) { "The selected document cannot be read." }
+                FileOutputStream(temporary).use { output ->
+                    LocalGlassesApkPolicy.copyBounded(input, output)
+                    output.fd.sync()
+                }
+            }
+            verifyFile(temporary, selection)
+            val target = apk(selection)
+            if (target.exists()) verifyFile(target, selection)
+            else check(temporary.renameTo(target)) { "Could not preserve the verified APK." }
+            if (selection.role == LocalGlassesApkRole.RECOVERY) {
+                write(recoveryRecord, selection.sha256)
+            }
+            target
+        } finally {
+            temporary.delete()
+        }
+    }
+
+    fun verify(selection: LocalGlassesApkSelection): File = synchronized(lock) {
+        apk(selection).also { verifyFile(it, selection) }
+    }
+
+    fun recovery(): LocalGlassesApkSelection = synchronized(lock) {
+        val hash = recoveryRecord.readFully().toString(Charsets.UTF_8)
+        LocalGlassesApkSelection(LocalGlassesApkRole.RECOVERY, hash).also { verify(it) }
+    }
+
+    fun hasAttempt(): Boolean = synchronized(lock) {
+        attemptRecord.baseFile.exists() || File(root, "transfer-attempt.bak").exists() ||
+            File(root, "transfer-attempt.new").exists()
+    }
+
+    /** Persist BEFORE the external call. An uncertain outcome must never be retried automatically. */
+    fun reserveAttempt(selection: LocalGlassesApkSelection) = synchronized(lock) {
+        check(!hasAttempt()) { "Inspect the glasses and acknowledge the previous attempt first." }
+        write(attemptRecord, "${selection.role}\n${selection.sha256}\nOutcome requires checking on glasses.\n")
+    }
+
+    fun acknowledgeAttempt() = synchronized(lock) { attemptRecord.delete() }
+
+    private fun apk(selection: LocalGlassesApkSelection): File {
+        require(selection.sha256.matches(Regex("[0-9a-f]{64}"))) { "Invalid expected SHA-256." }
+        return File(root, "${selection.sha256}.apk")
+    }
+
+    private fun verifyFile(file: File, selection: LocalGlassesApkSelection) {
+        require(file.isFile && file.length() in 1..LocalGlassesApkPolicy.MAX_BYTES) { "Saved APK is missing or invalid." }
+        val digest = MessageDigest.getInstance("SHA-256")
+        file.inputStream().use { input ->
+            val buffer = ByteArray(8192)
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                digest.update(buffer, 0, n)
+            }
+        }
+        val archive = AndroidArtifactPackageInspector(context.packageManager).inspect(file)
+        LocalGlassesApkPolicy.validate(
+            archive?.let {
+                LocalGlassesApkMetadata(it.packageName, it.versionCode, it.versionName,
+                    it.signingCertificates.map { cert -> hex(MessageDigest.getInstance("SHA-256").digest(cert)) })
+            },
+            hex(digest.digest()), selection,
+        )
+    }
+
+    private fun write(file: AtomicFile, value: String) {
+        val output = file.startWrite()
+        try {
+            output.write(value.toByteArray(Charsets.UTF_8))
+            file.finishWrite(output)
+            check(file.readFully().contentEquals(value.toByteArray(Charsets.UTF_8))) {
+                "Could not verify the saved APK/attempt record."
+            }
+        } catch (failure: Throwable) {
+            file.failWrite(output)
+            throw failure
+        }
+    }
+
+    companion object {
+        private val lock = Any()
+        private fun hex(bytes: ByteArray): String = bytes.joinToString("") { "%02x".format(it.toInt() and 255) }
+    }
+}
