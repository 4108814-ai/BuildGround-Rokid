+package com.anezium.rokidbus.phone
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.*
+import org.junit.Test
+
+class LocalGlassesApkPolicyTest {
+    private val policy = LocalGlassesApkPolicy
+    private val candidate = LocalGlassesApkSelection(LocalGlassesApkRole.CANDIDATE, policy.CANDIDATE_SHA)
+    private val recovery = LocalGlassesApkSelection(LocalGlassesApkRole.RECOVERY, "a".repeat(64))
+    private val valid = LocalGlassesApkMetadata(policy.PACKAGE, 10430L, "1.4.30", listOf(policy.SIGNER))
+
+    @Test fun acceptsOnlyPinnedCandidateAndSeparatelyHashedSameVersionRecovery() {
+        policy.validate(valid, candidate.sha256, candidate)
+        policy.validate(valid, recovery.sha256, recovery)
+    }
+
+    @Test fun rejectsWrongPackageVersionAndSignerEvenWithMatchingHash() {
+        listOf(null, valid.copy(packageName = "unrelated.app"), valid.copy(versionCode = 10429),
+            valid.copy(versionCode = 10431), valid.copy(versionName = "1.4.31"),
+            valid.copy(signerDigests = emptyList()), valid.copy(signerDigests = listOf("bad")),
+            valid.copy(signerDigests = listOf(policy.SIGNER, policy.SIGNER)))
+            .forEach { metadata -> rejects { policy.validate(metadata, candidate.sha256, candidate) } }
+    }
+
+    @Test fun rejectsTamperUnpinnedCandidateAndCandidateUsedAsRecovery() {
+        rejects { policy.validate(valid, recovery.sha256, candidate) }
+        rejects { policy.validate(valid, recovery.sha256, recovery.copy(role = LocalGlassesApkRole.CANDIDATE)) }
+        rejects { policy.validate(valid, candidate.sha256, candidate.copy(role = LocalGlassesApkRole.RECOVERY)) }
+        rejects { policy.validate(valid, "../x", recovery.copy(sha256 = "../x")) }
+    }
+
+    @Test fun boundedCopyRejectsEmptyAndOversizedStreamsWithoutTrustingProviderSize() {
+        rejects { policy.copyBounded(ByteArrayInputStream(byteArrayOf()), ByteArrayOutputStream(), 4) }
+        val output = ByteArrayOutputStream()
+        rejects { policy.copyBounded(ByteArrayInputStream(ByteArray(5)), output, 4) }
+        assertEquals(0, output.size())
+        policy.copyBounded(ByteArrayInputStream(ByteArray(4)), output, 4)
+        assertEquals(4, output.size())
+    }
+
+    @Test fun approvalExpiresAndRejectsClockRollbackOrNewConnectionOrService() {
+        val owner = Any()
+        fun approval() = LocalGlassesInstallApproval(candidate, recovery, owner, 7, 100)
+        assertFalse(approval().consume(owner, 7, 99))
+        assertFalse(approval().consume(owner, 7, 120101))
+        assertFalse(approval().consume(owner, 8, 101))
+        assertFalse(approval().consume(Any(), 7, 101))
+        assertTrue(approval().consume(owner, 7, 120100))
+        val queued = approval()
+        assertTrue(queued.consume(owner, 7, 101))
+        assertFalse(queued.isContextCurrent(owner, 7, 120101))
+    }
+
+    @Test fun concurrentConfirmationsConsumeOneApprovalOnlyOnce() {
+        val owner = Any()
+        val approval = LocalGlassesInstallApproval(candidate, recovery, owner, 1, 0)
+        val pool = Executors.newFixedThreadPool(8)
+        try {
+            val start = CountDownLatch(1)
+            val results = (1..64).map { pool.submit<Boolean> { start.await(); approval.consume(owner, 1, 1) } }
+            start.countDown()
+            assertEquals(1, results.count { it.get(3, TimeUnit.SECONDS) })
+            assertFalse(approval.consume(owner, 1, 2))
+        } finally { pool.shutdownNow() }
+    }
+
+    private fun rejects(work: () -> Unit) {
+        try { work(); fail("Expected fail-closed rejection") } catch (_: IllegalArgumentException) { }
+    }
+}
