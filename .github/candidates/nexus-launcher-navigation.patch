+package com.anezium.rokidbus.glasses
+
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Delivers transport updates on the UI dispatcher only while this view session lives. */
+internal class LauncherListDelivery<T>(
+    private val dispatch: (() -> Unit) -> Unit,
+    private val deliver: (T) -> Unit,
+) : AutoCloseable {
+    private val active = AtomicBoolean(true)
+
+    fun accept(value: T) {
+        dispatch { if (active.get()) deliver(value) }
+    }
+
+    override fun close() { active.set(false) }
+}
