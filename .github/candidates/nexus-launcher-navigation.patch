+package com.anezium.rokidbus.glasses
+
+import android.view.KeyEvent
+
+/** Local Logcat only; 64 records / five minutes maximum per process. No telemetry. */
+internal object LauncherNavigationDiagnostics {
+    private val trace = LauncherNavigationTrace(::log)
+    fun record(event: KeyEvent, owner: LauncherNavigationTrace.Owner,
+        before: Int = -1, after: Int = -1, count: Int = -1) {
+        val visible = LauncherOverlayRenderer.isShown() ||
+            (MainActivity.isResumed() && !MainActivity.isInteractiveFlowActive())
+        trace.record(visible, event.eventTime, event.keyCode, event.action,
+            event.repeatCount, owner, before, after, count)
+    }
+}
