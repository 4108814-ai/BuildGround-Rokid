+package com.anezium.rokidbus.glasses
+
+/** Bounded local diagnostic: only launcher navigation codes, never text or payloads. */
+internal class LauncherNavigationTrace(private val sink: (String) -> Unit) {
+    enum class Owner { MAIN, OVERLAY, NOTICE, SURFACE, ACTIVITY, UNCLAIMED }
+    private var firstAt: Long? = null
+    private var remaining = 64
+
+    @Synchronized fun record(visible: Boolean, at: Long, key: Int, action: Int,
+        repeat: Int, owner: Owner, before: Int, after: Int, count: Int) {
+        if (!visible || key !in setOf(4, 19, 20, 21, 22, 23, 66) || action !in 0..1) return
+        val start = firstAt ?: at.also { firstAt = it }
+        if (at < start || at - start > 300_000L || remaining == 0) return
+        remaining--
+        val gesture = when (key) { 19, 21 -> "BACKWARD"; 20, 22 -> "FORWARD"; 4 -> "BACK"; else -> "CONFIRM" }
+        sink("NAV t=$at gesture=$gesture key=$key action=$action repeat=$repeat owner=$owner before=$before after=$after count=$count")
+    }
+}
