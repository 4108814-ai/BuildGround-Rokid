+package com.anezium.rokidbus.shared
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** Fixed vocabulary only: no caller-supplied event details or exception messages. */
+object SppDiagnostics {
+    const val PREFIX = "/core/spp-diagnostic/"
+    const val REQUEST = PREFIX + "request"
+    const val RESULT = PREFIX + "result"
+    const val LIMIT = 64
+    const val MAX_BYTES = 24 * 1024
+    const val TTL = 5 * 60_000L
+    const val BUILD = "SPP_DIAG_01_20261101"
+    enum class Event {
+        PROCESS, DIAGNOSTIC_OPEN, SERVICE_CREATE, FOREGROUND_READY, FOREGROUND_ERROR, SERVICE_START, SERVICE_DESTROY,
+        CORE_REQUEST, CORE_STARTED, CORE_WAIT_UNLOCK, FOLDED, UNFOLDED, FOLD_UNKNOWN, WORN, REMOVED, WEAR_UNKNOWN, TRANSPORT_WAKE, START_REQUEST,
+        ALREADY_STARTED, LISTEN_BEGIN, LISTEN_READY, ACCEPT_WAIT, ACCEPTED,
+        LISTEN_ERROR, LISTEN_CLOSED, LISTENER_THREAD_END, INSTALL_BEGIN, INSTALL_END, SESSION_READY,
+        SESSION_END, SESSION_ERROR, WRITE_ERROR, CONNECT_BEGIN, SOCKET_CREATED, CONNECT_END,
+        OUTPUT_READY, CLIENT_INSTALL_BEGIN, CLIENT_INSTALL_END, CLIENT_READ, CLIENT_ERROR, CLIENT_END
+    }
+    enum class Error { NONE, IO, SECURITY, INTERRUPTED, OTHER }
+    fun category(error: Throwable?): Error = when (error) {
+        null -> Error.NONE
+        is SecurityException -> Error.SECURITY
+        is java.io.IOException -> Error.IO
+        is InterruptedException -> Error.INTERRUPTED
+        else -> Error.OTHER
+    }
+    data class Row(val epoch: String, val seq: Long, val at: Long, val mono: Long,
+        val event: Event, val generation: Long, val error: Error)
+    fun validToken(s: String) = s.matches(Regex("[a-f0-9]{32}"))
+    fun encode(rows: List<Row>): JSONArray = JSONArray().apply {
+        rows.forEach { r -> put(JSONObject().put("epoch", r.epoch).put("seq", r.seq)
+            .put("at", r.at).put("mono", r.mono).put("event", r.event.name)
+            .put("generation", r.generation).put("error", r.error.name)) }
+    }
+    fun decode(a: JSONArray, now: Long): List<Row> {
+        require(a.length() <= LIMIT && a.toString().toByteArray(Charsets.UTF_8).size <= MAX_BYTES)
+        return (0 until a.length()).mapNotNull { i ->
+            val r = a.getJSONObject(i)
+            require(r.keys().asSequence().toSet() == setOf("epoch", "seq", "at", "mono", "event", "generation", "error"))
+            val row = Row(r.getString("epoch"), r.getLong("seq"), r.getLong("at"),
+                r.getLong("mono"), Event.valueOf(r.getString("event")),
+                r.getLong("generation"), Error.valueOf(r.getString("error")))
+            require(validToken(row.epoch) && row.seq >= 0 && row.at >= 0 && row.mono >= 0 && row.generation >= 0)
+            row.takeIf { it.at <= now && now - it.at <= TTL }
+        }
+    }
+    /** Reject unknown fields, arbitrary text and oversized data before any display or storage. */
+    fun validate(payload: JSONObject, nonce: String): JSONObject {
+        require(payload.toString().toByteArray(Charsets.UTF_8).size <= MAX_BYTES)
+        require(payload.keys().asSequence().toSet() == setOf("nonce", "capturedAt", "build", "version", "code", "epoch", "revision", "persisted", "gaps", "listenerStage", "listenerGeneration", "listenerAt", "rows"))
+        require(validToken(nonce) && payload.getString("nonce") == nonce)
+        require(payload.getString("build") == BUILD)
+        require(payload.getString("version").matches(Regex("[0-9.]{1,24}")))
+        require(payload.getLong("code") > 0 && validToken(payload.getString("epoch")))
+        require(payload.getLong("revision") >= 0 && payload.getLong("persisted") >= -1 && payload.getLong("gaps") >= 0)
+        require(payload.getString("listenerStage") in setOf("UNKNOWN", "LISTEN_BEGIN", "LISTEN_READY", "ACCEPT_WAIT", "ACCEPTED", "LISTEN_ERROR", "LISTEN_CLOSED", "LISTENER_THREAD_END"))
+        require(payload.getLong("listenerGeneration") >= 0 && payload.getLong("listenerAt") >= 0)
+        val capturedAt = payload.getLong("capturedAt")
+        require(capturedAt >= 0 && payload.getLong("persisted") <= payload.getLong("revision"))
+        val rows = decode(payload.getJSONArray("rows"), capturedAt)
+        return JSONObject(payload.toString()).put("rows", encode(rows))
+    }
+}
+
+/** Short synchronized memory operations only. Persistence and transport stay outside this lock. */
+class SppDiagnosticRing(private val epoch: String, private val wall: () -> Long,
+    private val mono: () -> Long, restored: List<SppDiagnostics.Row> = emptyList()) {
+    private val rows = ArrayDeque(restored.takeLast(SppDiagnostics.LIMIT))
+    private var sequence = 0L
+    var revision = 0L; private set
+    var gaps = 0L; private set
+    init { require(SppDiagnostics.validToken(epoch)) }
+    @Synchronized fun record(event: SppDiagnostics.Event, generation: Long = 0,
+        error: SppDiagnostics.Error = SppDiagnostics.Error.NONE) {
+        trim()
+        if (rows.size == SppDiagnostics.LIMIT) { rows.removeFirst(); gaps++ }
+        rows.addLast(SppDiagnostics.Row(epoch, ++sequence, wall(), mono(), event, generation, error))
+        revision++
+    }
+    @Synchronized fun snapshot(): Triple<List<SppDiagnostics.Row>, Long, Long> {
+        trim(); return Triple(rows.toList(), revision, gaps)
+    }
+    private fun trim() {
+        val now = wall()
+        val kept = rows.filter { it.at <= now && now - it.at <= SppDiagnostics.TTL }
+        if (kept.size != rows.size) { gaps += rows.size - kept.size; rows.clear(); rows.addAll(kept); revision++ }
+    }
+}
+
+/** One explicit request. Correlation expires even when the UI/main loop was suspended. */
+class SppDiagnosticPending {
+    private var nonce: String? = null
+    private var deadline = 0L
+    private var lastStart = -10_000L
+    @Synchronized fun begin(token: String, now: Long): Boolean {
+        require(SppDiagnostics.validToken(token))
+        if (nonce != null || now - lastStart < 5_000) return false
+        nonce = token; lastStart = now; deadline = now + 4_000
+        return true
+    }
+    @Synchronized fun matches(token: String, now: Long): Boolean = nonce == token && now < deadline
+    @Synchronized fun clear() { nonce = null }
+}
