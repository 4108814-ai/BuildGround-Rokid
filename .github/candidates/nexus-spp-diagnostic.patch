+package com.anezium.rokidbus.shared
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+class SppDiagnosticsTest {
+    private val token = "a".repeat(32)
+    private val other = "b".repeat(32)
+    private fun payload() = JSONObject().put("nonce", token).put("capturedAt",1001).put("build", SppDiagnostics.BUILD)
+        .put("version", "1.4.30").put("code",10430).put("epoch",token)
+        .put("revision",1).put("persisted",0).put("gaps",0)
+        .put("listenerStage","ACCEPT_WAIT").put("listenerGeneration",1).put("listenerAt",1000)
+        .put("rows", SppDiagnostics.encode(listOf(SppDiagnostics.Row(token,1,1000,20,SppDiagnostics.Event.ACCEPT_WAIT,1,SppDiagnostics.Error.NONE))))
+    private fun rejected(block: () -> Unit) { try { block(); fail("accepted") } catch (_: IllegalArgumentException) {} }
+    @Test fun boundedRing() {
+        val ring = SppDiagnosticRing(token,{1000},{20})
+        repeat(1000) { ring.record(SppDiagnostics.Event.ACCEPT_WAIT, 1) }
+        assertEquals(64,ring.snapshot().first.size); assertEquals(936L,ring.snapshot().third)
+        assertEquals(1000L,ring.snapshot().first.last().seq)
+    }
+    @Test fun expiresWithoutNewEvents() {
+        var now=1000L; val ring=SppDiagnosticRing(token,{now},{20})
+        ring.record(SppDiagnostics.Event.PROCESS); now += SppDiagnostics.TTL+1
+        assertTrue(ring.snapshot().first.isEmpty()); assertTrue(ring.snapshot().second>1)
+    }
+    @Test fun clockRollbackDropsFutureRows() {
+        var now=1000L; val ring=SppDiagnosticRing(token,{now},{20})
+        ring.record(SppDiagnostics.Event.PROCESS); now=999
+        assertTrue(ring.snapshot().first.isEmpty())
+    }
+    @Test fun preservesPriorEpochSeparately() {
+        val old=SppDiagnostics.Row(other,1,1000,1,SppDiagnostics.Event.ACCEPT_WAIT,7,SppDiagnostics.Error.NONE)
+        val ring=SppDiagnosticRing(token,{1000},{2},listOf(old));ring.record(SppDiagnostics.Event.PROCESS)
+        assertEquals(listOf(other,token),ring.snapshot().first.map{it.epoch})
+    }
+    @Test fun concurrentRecordsHaveUniqueSequence() {
+        val ring=SppDiagnosticRing(token,{1000},{20});val pool=Executors.newFixedThreadPool(4)
+        try { val done=CountDownLatch(4); repeat(4){pool.execute{repeat(100){ring.record(SppDiagnostics.Event.INSTALL_BEGIN)};done.countDown()}}
+            assertTrue(done.await(5,TimeUnit.SECONDS));assertEquals(400L,ring.snapshot().second)
+            val seq=ring.snapshot().first.map{it.seq};assertEquals(seq.size,seq.toSet().size)
+        } finally {pool.shutdownNow()}
+    }
+    @Test fun strictRoundTrip() {assertEquals("ACCEPT_WAIT",SppDiagnostics.validate(payload(),token).getString("listenerStage"))}
+    @Test fun rejectsArbitraryFields() {rejected{SppDiagnostics.validate(payload().put("address","private"),token)}}
+    @Test fun rejectsArbitraryEventText() {
+        val p=payload();p.getJSONArray("rows").getJSONObject(0).put("event","message text")
+        rejected{SppDiagnostics.validate(p,token)}
+    }
+    @Test fun rejectsWrongNonce() {rejected{SppDiagnostics.validate(payload(),other)}}
+    @Test fun rejectsUnknownBuild() {rejected{SppDiagnostics.validate(payload().put("build","unknown"),token)}}
+    @Test fun rejectsOversizedData() {rejected{SppDiagnostics.validate(payload().put("extra","x".repeat(25000)),token)}}
+    @Test fun rejectsTooManyRecords() {
+        val p=payload();val row=p.getJSONArray("rows").getJSONObject(0);p.put("rows",JSONArray().apply{repeat(65){put(row)}})
+        rejected{SppDiagnostics.validate(p,token)}
+    }
+    @Test fun requestExpiresEvenWithDelayedMainCallback() {
+        val p=SppDiagnosticPending();assertTrue(p.begin(token,1000));assertTrue(p.matches(token,4999))
+        assertFalse(p.matches(token,5000));assertFalse(p.matches(other,1001));p.clear();assertFalse(p.matches(token,1001))
+    }
+    @Test fun duplicateAndOldReplyCannotMatchNewRequest() {
+        val p=SppDiagnosticPending();assertTrue(p.begin(token,1000));assertFalse(p.begin(other,1001))
+        p.clear();assertFalse(p.begin(other,4000));assertTrue(p.begin(other,6000))
+        assertFalse(p.matches(token,6001));assertTrue(p.matches(other,6001))
+    }
+    @Test fun onlyOneConcurrentRequest() {
+        val p=SppDiagnosticPending();val pool=Executors.newFixedThreadPool(4)
+        try {val results=(0..7).map{pool.submit<Boolean>{p.begin(token,1000)}}.map{it.get()}
+            assertEquals(1,results.count{it})
+        }finally{pool.shutdownNow()}
+    }
+}
