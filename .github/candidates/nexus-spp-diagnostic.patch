+class SppDiagnosticActivity : Activity() {
+    private var live = true
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val output = TextView(this).apply { text = "One CXR-only snapshot. Does not start, repair or install anything. No reply is inconclusive."; setTextIsSelectable(true) }
