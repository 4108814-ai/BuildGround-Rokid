+package com.anezium.rokidbus.glasses
+
+import android.app.Activity
+import android.os.Bundle
+import android.widget.ScrollView
+import android.widget.TextView
+
+/** Fallback only: foregrounding can unfreeze/recreate this process. No transport/core call. */
+class SppDiagnosticActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        SppDiagnosticJournal.initialize(applicationContext)
+        val frozen = SppDiagnosticJournal.snapshot("00000000000000000000000000000000")
+        SppDiagnosticJournal.record(com.anezium.rokidbus.shared.SppDiagnostics.Event.DIAGNOSTIC_OPEN)
+        val rows = frozen.getJSONArray("rows")
+        val summary = buildString {
+            append("Build ").append(frozen.getString("build")).append(" / ").append(frozen.getString("version"))
+            append("\nEpoch ").append(frozen.getString("epoch").takeLast(8))
+            append("\nLast listener stage (not a health probe): ").append(frozen.getString("listenerStage"))
+            append(" / generation ").append(frozen.getLong("listenerGeneration"))
+            append("\nMemory/persisted revision: ").append(frozen.getLong("revision")).append("/").append(frozen.getLong("persisted"))
+            append(" / gaps ").append(frozen.getLong("gaps"))
+            for (i in maxOf(0, rows.length() - 8) until rows.length()) {
+                val row = rows.getJSONObject(i)
+                append("\n").append(row.getString("epoch").takeLast(8)).append(" ")
+                    .append(row.getString("event")).append(" g").append(row.getLong("generation"))
+                    .append(" ").append(row.getString("error"))
+            }
+        }
+        setContentView(ScrollView(this).apply { addView(TextView(this@SppDiagnosticActivity).apply {
+            textSize = 14f
+            text = "SPP DIAG 01 - READ ONLY\nOpening this screen can start/unfreeze the process. Prior events may be unflushed. No repair performed.\n" + summary
+        }) })
+    }
+}
