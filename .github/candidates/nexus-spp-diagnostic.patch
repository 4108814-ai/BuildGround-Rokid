+package com.anezium.rokidbus.glasses
+
+import android.content.Context
+import android.os.SystemClock
+import com.anezium.rokidbus.shared.SppDiagnostics
+import com.anezium.rokidbus.shared.SppDiagnosticRing
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.UUID
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Bounded private journal. No disk/SDK calls run on listener/session transition threads. */
+internal object SppDiagnosticJournal {
+    private val epoch = UUID.randomUUID().toString().replace("-", "")
+    private val writer = Executors.newSingleThreadScheduledExecutor()
+    private val pending = AtomicBoolean()
+    @Volatile private var ring: SppDiagnosticRing? = null
+    private var prefs: android.content.SharedPreferences? = null
+    @Volatile private var persisted = -1L
+    @Volatile private var persistenceFailed = false
+    private data class Listener(val stage: String, val generation: Long, val at: Long)
+    @Volatile private var listener = Listener("UNKNOWN", 0, 0)
+    @Synchronized fun initialize(context: Context) {
+        if (ring != null) return
+        // Non-secret bounded data only; device-protected app-private storage also works before unlock.
+        prefs = runCatching { context.createDeviceProtectedStorageContext().getSharedPreferences("spp_diagnostic_v1", Context.MODE_PRIVATE) }.getOrNull()
+        val old = runCatching {
+            val raw = prefs?.getString("rows", "[]") ?: "[]"
+            require(raw.length <= SppDiagnostics.MAX_BYTES)
+            SppDiagnostics.decode(JSONArray(raw), System.currentTimeMillis())
+        }.getOrElse { persistenceFailed = true; emptyList() }
+        ring = SppDiagnosticRing(epoch, System::currentTimeMillis, SystemClock::elapsedRealtime, old)
+        record(SppDiagnostics.Event.PROCESS)
+        writer.scheduleWithFixedDelay({ persist() }, 60, 60, java.util.concurrent.TimeUnit.SECONDS)
+    }
+    fun record(event: SppDiagnostics.Event, generation: Long = 0, error: Throwable? = null) {
+        val r = ring ?: return
+        val category = when (error) {
+            null -> SppDiagnostics.Error.NONE
+            is SecurityException -> SppDiagnostics.Error.SECURITY
+            is java.io.IOException -> SppDiagnostics.Error.IO
+            is InterruptedException -> SppDiagnostics.Error.INTERRUPTED
+            else -> SppDiagnostics.Error.OTHER
+        }
+        if (event in setOf(SppDiagnostics.Event.LISTEN_BEGIN, SppDiagnostics.Event.LISTEN_READY,
+                SppDiagnostics.Event.ACCEPT_WAIT, SppDiagnostics.Event.ACCEPTED,
+                SppDiagnostics.Event.LISTEN_ERROR, SppDiagnostics.Event.LISTEN_CLOSED, SppDiagnostics.Event.LISTENER_THREAD_END)) {
+            listener = Listener(event.name, generation, System.currentTimeMillis())
+        }
+        r.record(event, generation, category)
+        persist()
+    }
+    private fun persist() {
+        if (!pending.compareAndSet(false, true)) return
+        writer.execute {
+            val s = ring?.snapshot()
+            try {
+                if (s != null) {
+                    val ok = prefs?.edit()?.putString("rows", SppDiagnostics.encode(s.first).toString())?.commit() == true
+                    persistenceFailed = !ok
+                    if (ok) persisted = s.second
+                }
+            } catch (_: Exception) { persistenceFailed = true }
+            finally {
+                pending.set(false)
+                // One coalesced task, never a queue of writes for every transport event.
+                if (s != null && ring?.snapshot()?.second != s.second) persist()
+            }
+        }
+    }
+    fun snapshot(nonce: String): JSONObject {
+        require(SppDiagnostics.validToken(nonce))
+        val s = ring?.snapshot() ?: Triple(emptyList(), 0L, 0L)
+        val observed = listener
+        return JSONObject().put("nonce", nonce).put("capturedAt", System.currentTimeMillis()).put("build", SppDiagnostics.BUILD)
+            .put("version", BuildConfig.VERSION_NAME).put("code", BuildConfig.VERSION_CODE)
+            .put("epoch", epoch).put("revision", s.second).put("persisted", persisted)
+            .put("gaps", s.third + if (persistenceFailed) 1 else 0)
+            .put("listenerStage", observed.stage).put("listenerGeneration", observed.generation)
+            .put("listenerAt", observed.at)
+            .put("rows", SppDiagnostics.encode(s.first))
+    }
+}
