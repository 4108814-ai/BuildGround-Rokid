+package com.anezium.rokidbus.glasses
+
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicReference
+
+/**
+ * One immutable socket/output pair per connection. Only the transition thread
+ * changes ownership and emits link state. Callbacks run without an I/O lock and
+ * may call clearIfCurrent (which queues work rather than waiting reentrantly).
+ * install is called only by client reader threads, never by the callback.
+ */
+internal class SppSessionOwner<T : Any>(
+    private val retireSession: (T) -> Unit,
+    private val onConnected: (Boolean) -> Unit,
+) : AutoCloseable {
+    private val active = AtomicReference<T?>(null)
+    private val transitions = Executors.newSingleThreadExecutor { task ->
+        Thread(task, "rokidbus-spp-state").apply { isDaemon = true }
+    }
+
+    fun current(): T? = active.get()
+
+    fun install(session: T): T? {
+        val future = transitions.submit<T?> {
+            val retired = active.getAndSet(session)
+            // Retire before a reentrant connected callback can send on replacement.
+            // Socket close must not acquire the writer lock; it unblocks old I/O.
+            if (retired != null) retireSession(retired)
+            onConnected(true)
+            retired
+        }
+        // Once submitted, installation owns session until its outcome is known.
+        // An interrupted reader must not close it while publication is queued.
+        var interrupted = false
+        try {
+            while (true) {
+                try { return future.get() }
+                catch (_: InterruptedException) { interrupted = true }
+            }
+        } finally {
+            if (interrupted) Thread.currentThread().interrupt()
+        }
+    }
+
+    fun clearIfCurrent(expected: T) {
+        transitions.execute {
+            // Atomic identity check: an old reader/writer cannot clear its successor.
+            if (active.compareAndSet(expected, null)) onConnected(false)
+        }
+    }
+
+    /** Test barrier; must not be called by onConnected. */
+    internal fun awaitIdle() { transitions.submit {}.get() }
+
+    override fun close() { transitions.shutdown() }
+}
