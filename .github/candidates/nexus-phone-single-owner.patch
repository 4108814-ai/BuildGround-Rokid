+        if (binding !== candidate) return null
+        val retired = Released(candidate, service, deviceConnected)
+        binding = null
+        epoch++
+        service = null
+        deviceConnected = false
+        revision++
+        return retired
+    }
+
+    @Synchronized fun releaseCurrent(): Released<B, S>? = binding?.let { release(it) }
+
+    @Synchronized fun probe(): Probe<B, S>? {
+        val b = binding ?: return null
+        val s = service ?: return null
+        return Probe(b, s, epoch, revision)
+    }
+
+    @Synchronized fun ownsService(probe: Probe<B, S>): Boolean =
+        binding === probe.binding && service === probe.service && epoch == probe.epoch
+
+    @Synchronized fun deviceEvent(candidate: B, remote: S, connected: Boolean): Boolean? {
+        if (binding !== candidate || service !== remote) return null
+        val changed = deviceConnected != connected
+        deviceConnected = connected
+        revision++
+        return changed
+    }
+
+    @Synchronized fun applyProbe(probe: Probe<B, S>, connected: Boolean): Boolean? {
+        if (!ownsService(probe) || revision != probe.revision) return null
+        return deviceEvent(probe.binding, probe.service, connected)
+    }
+}
