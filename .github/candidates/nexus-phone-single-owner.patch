+package com.anezium.rokidbus.phone
+
+/** Three consecutive automatic bind retries per outage; never resets a pending registration. */
+internal class CxrRecoveryPolicy {
+    enum class Action { NONE, CONNECT, REFRESH }
+    private var generation = 0L
+    private var active = false
+    private var bindAttempts = 0
+    private var nextBindAt = 0L
+    private var nextRefreshAt = 0L
+
+    @Synchronized fun start(): Long {
+        generation++
+        active = true
+        bindAttempts = 0
+        nextBindAt = 0L
+        nextRefreshAt = 0L
+        return generation
+    }
+
+    @Synchronized fun stop() { generation++; active = false }
+    @Synchronized fun isCurrent(expected: Long): Boolean = active && generation == expected
+    @Synchronized fun exhausted(): Boolean = active && bindAttempts >= 3
+
+    @Synchronized fun next(
+        expected: Long,
+        nowMs: Long,
+        bindingActive: Boolean,
+        serviceConnected: Boolean,
+        controlUp: Boolean,
+    ): Action {
+        if (!isCurrent(expected)) return Action.NONE
+        if (controlUp) {
+            bindAttempts = 0
+            nextBindAt = 0L
+            nextRefreshAt = 0L
+            return Action.NONE
+        }
+        if (serviceConnected) {
+            if (nowMs < nextRefreshAt) return Action.NONE
+            nextRefreshAt = nowMs + 5_000L
+            return Action.REFRESH
+        }
+        // Android owns completion/reconnection of this registration, regardless of elapsed time.
+        if (bindingActive || bindAttempts >= 3 || nowMs < nextBindAt) return Action.NONE
+        val delay = longArrayOf(1_000L, 5_000L, 15_000L)[bindAttempts]
+        bindAttempts++
+        nextBindAt = nowMs + delay
+        return Action.CONNECT
+    }
+}
