+package com.example.cxrglobal
+
+/** Identity ownership only. Never calls Android, Binder, callbacks, or user code under its lock. */
+internal class CxrBindingOwner<B : Any, S : Any> {
+    data class Probe<B, S>(val binding: B, val service: S, val epoch: Long, val revision: Long)
+    data class Released<B, S>(val binding: B, val service: S?, val deviceConnected: Boolean)
+
+    private var binding: B? = null
+    private var service: S? = null
+    private var deviceConnected = false
+    private var revision = 0L
+    private var epoch = 0L
+
+    @Synchronized fun reserve(candidate: B): Boolean {
+        if (binding != null) return false
+        binding = candidate
+        epoch++
+        revision++
+        return true
+    }
+
+    @Synchronized fun owns(candidate: B): Boolean = binding === candidate
+    @Synchronized fun hasBinding(): Boolean = binding != null
+    @Synchronized fun currentService(): S? = service
+    @Synchronized fun isDeviceConnected(): Boolean = deviceConnected
+
